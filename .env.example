# ============================================
# ALMA SOLICITUDES - CONFIGURATION
# ============================================

# Modo de flujo (cliente, se hornea en el build de Vite):
#   'solicitud'    -> hace POST al CRM tracker + envía correo (deploy por defecto)
#   'actualizacion' -> NO hace POST al tracker, SOLO envía correo (mismo template, título distinto)
# En el deploy de "Actualización" configurar VITE_FLOW_MODE=actualizacion en Dokploy.
VITE_FLOW_MODE=solicitud

# Resend (server-side — usado por server.js, NUNCA como VITE_*)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=notificaciones@almacenajes.net

# Firebase Configuration
VITE_API_KEY=your_firebase_api_key
VITE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_PROJECT_ID=your_firebase_project_id
VITE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_APP_ID=your_firebase_app_id
VITE_MEASUREMENT_ID=your_firebase_measurement_id

# CRM Tracker API
VITE_CRM_API_URL=http://localhost:4000/api/v1
